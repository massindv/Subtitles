1
00:00:00,319 --> 00:00:08,537
أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ.

2
00:00:08,537 --> 00:00:18,271
إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ،

3
00:00:18,271 --> 00:00:28,612
يَا أَيُّهَا الَّذِينَ آمَنُوا صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا.

4
00:00:28,963 --> 00:00:39,734
اللَّهُمَّ صَلِّ عَلَى مَنْ مِنْهُ انْشَقَّتِ الْأَسْرَارُ،

5
00:00:39,734 --> 00:00:47,154
وَانْفَلَقَتِ الْأَنْوَارُ،

6
00:00:47,154 --> 00:00:52,978
وَفِيهِ ارْتَقَتِ الْحَقَائِقُ،

7
00:00:52,978 --> 00:01:02,122
وَتَنَزَّلَتْ عُلُومُ آدَمَ فَأَعْجَزَ الْخَلَائِقَ.

8
00:01:02,472 --> 00:01:08,777
اللَّهُمَّ صَلِّ عَلَيْهِ…

9
00:01:08,777 --> 00:01:16,804
اللَّهُمَّ صَلِّ عَلَيْهِ…

10
00:01:17,153 --> 00:01:22,819
وَلَهُ تَضَاءَلَتِ الْفُهُومُ،

11
00:01:22,819 --> 00:01:28,245
فَلَمْ يُدْرِكْهُ مِنَّا سَابِقٌ وَلَا لَاحِقٌ.

12
00:01:28,245 --> 00:01:34,548
فَرِيَاضُ الْمَلَكُوتِ بِزَهْرِ جَمَالِهِ مُونِقَةٌ،

13
00:01:34,548 --> 00:01:41,090
وَحِيَاضُ الْجَبَرُوتِ بِفَيْضِ أَنْوَارِهِ مُتَدَفِّقَةٌ.

14
00:01:41,090 --> 00:01:51,144
وَلَا شَيْءَ إِلَّا وَهُوَ بِهِ مَنُوطٌ،

15
00:01:51,144 --> 00:01:56,218
إِذْ لَوْلَا الْوَاسِطَةُ لَذَهَبَ كَمَا قِيلَ الْمَوْسُوطُ.

16
00:01:56,569 --> 00:01:58,802
صَلَاةً تَلِيقُ بِكَ،

17
00:01:58,802 --> 00:01:59,920
مِنْكَ إِلَيْهِ،

18
00:01:59,920 --> 00:02:02,442
كَمَا هُوَ أَهْلُهُ.

19
00:02:02,793 --> 00:02:08,936
اللَّهُمَّ إِنَّهُ سِرُّكَ الْجَامِعُ الدَّالُّ عَلَيْكَ،

20
00:02:08,936 --> 00:02:14,889
وَحِجَابُكَ الْأَعْظَمُ الْقَائِمُ لَكَ بَيْنَ يَدَيْكَ.

21
00:02:15,239 --> 00:02:18,909
اللَّهُمَّ صَلِّ عَلَيْهِ…

22
00:02:18,909 --> 00:02:27,415
وَسَلِّمْ تَسْلِيمًا…

23
00:02:27,765 --> 00:02:31,995
اللَّهُمَّ أَلْحِقْنِي بِنَسَبِهِ،

24
00:02:31,995 --> 00:02:35,265
وَحَقِّقْنِي بِحَسَبِهِ،

25
00:02:35,265 --> 00:02:40,372
وَعَرِّفْنِي إِيَّاهُ مَعْرِفَةً

26
00:02:40,372 --> 00:02:44,361
أَسْلَمُ بِهَا مِنْ مَوَارِدِ الْجَهْلِ،

27
00:02:44,361 --> 00:02:48,001
وَأَكْرَعُ بِهَا مِنْ مَوَارِدِ الْفَضْل

28
00:02:48,350 --> 00:02:48,371
ِ.

29
00:02:48,350 --> 00:02:54,335
وَاحْمِلْنِي عَلَى سَبِيلِهِ إِلَى حَضْرَتِكَ،

30
00:02:54,335 --> 00:02:54,354
حَمْلًا مَحْفُوفًا بِنُصْرَتِكَ.

31
00:02:54,597 --> 00:02:55,800
اللَّهُمَّ…

32
00:02:55,800 --> 00:02:57,003
اللَّهُمَّ…

33
00:02:57,526 --> 00:03:12,686
وَاقْذِفْ بِي عَلَى الْبَاطِلِ فَأَدْمَغَهُ،

34
00:03:12,686 --> 00:03:16,515
وَزُجَّ بِي فِي بِحَارِ الْأَحَدِيَّةِ،

35
00:03:16,515 --> 00:03:20,445
وَانْشُلْنِي مِنْ أَوْحَالِ التَّوْحِيدِ،

36
00:03:20,425 --> 00:03:23,905
وَأَغْرِقْنِي فِي عَيْنِ بَحْرِ الْوَحْدَةِ.

37
00:03:24,254 --> 00:03:28,723
حَتَّى لَا أَرَى،

38
00:03:28,723 --> 00:03:31,675
وَلَا أَسْمَعَ،

39
00:03:31,675 --> 00:03:34,308
وَلَا أَجِدَ،

40
00:03:34,308 --> 00:03:36,701
وَلَا أُحِسَّ،

41
00:03:36,701 --> 00:03:36,722
إِلَّا بِهَا.

42
00:03:36,973 --> 00:03:37,883
اللَّهُ…

43
00:03:37,883 --> 00:03:38,790
اللَّهُ…

44
00:03:39,335 --> 00:03:49,068
وَاجْعَلِ الْحِجَابَ الْأَعْظَمَ حَيَاةَ رُوحِي،

45
00:03:49,068 --> 00:03:52,818
وَرُوحَهُ سِرَّ حَقِيقَتِي،

46
00:03:52,818 --> 00:03:57,048
وَحَقِيقَتَهُ جَامِعَ عَوَالِمِي،

47
00:03:57,048 --> 00:04:12,735
بِتَحْقِيقِ الْحَقِّ الْأَوَّلِ.

48
00:04:13,085 --> 00:04:35,235
يَا أَوَّلُ…

49
00:04:35,584 --> 00:04:38,298
يَا أَوَّلُ…

50
00:04:38,298 --> 00:04:43,723
وَانْصُرْنِي بِكَ لَكَ،

51
00:04:43,723 --> 00:04:46,355
وَأَيِّدْنِي بِكَ لَكَ،

52
00:04:46,355 --> 00:04:49,387
وَاجْمَعْ بَيْنِي وَبَيْنَكَ،

53
00:04:49,387 --> 00:04:53,026
وَحُلْ بَيْنِي وَبَيْنَ غَيْرِكَ.
